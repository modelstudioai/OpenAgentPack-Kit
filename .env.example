# ---- Bailian Managed Agent 凭据（只存在于服务端，绝不下发浏览器）----
BAILIAN_API_KEY=
# 二选一：显式 base_url，或用 workspace_id 推导
BAILIAN_BASE_URL=
BAILIAN_WORKSPACE_ID=

# ---- kit server ----
PORT=8787
KIT_DATA_DIR=.data
# 管理端单管理员 bearer token（v1 方案；企业 RBAC/BUC 留后续）
ADMIN_TOKEN=change-me
# 体验页默认必须使用管理员创建的成员账号登录；仅演示兼容可显式选 anonymous
KIT_AUTH_MODE=member
# 可选的可信 JWT 身份扩展；不配置也可使用本地成员登录
KIT_JWT_SECRET=
# 允许跨域的体验页来源，逗号分隔；本地开发默认放行
KIT_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:*
# 可选：跨域部署时的公开服务地址
# KIT_PUBLIC_BASE_URL=
# 可选：追加 admin/auditor 令牌，格式 <token>:<role>，逗号分隔
# KIT_ADMIN_TOKENS=

# ---- 无凭据时的演示模式：用内置 mock gateway 跑通端到端 ----
KIT_GATEWAY=auto

# 评测浏览（console「评测」tab / admin.eval.*）：逗号分隔的 <skill-dir>-workspace 根目录
# KIT_EVAL_WORKSPACES=/path/to/my-skill-workspace,/path/to/other-workspace
