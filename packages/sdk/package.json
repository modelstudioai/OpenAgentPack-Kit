{
  "name": "@openagentpack/kit-sdk",
  "version": "1.0.0",
  "private": true,
  "description": "OpenAgentPack Kit SDK：数据处理、协议契约、会话运行时、后端适配与可选 React 适配层",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./chat": {
      "types": "./dist/chat.d.ts",
      "import": "./dist/chat.js",
      "default": "./dist/chat.js"
    },
    "./sessions": {
      "types": "./dist/sessions.d.ts",
      "import": "./dist/sessions.js",
      "default": "./dist/sessions.js"
    },
    "./files": {
      "types": "./dist/files.d.ts",
      "import": "./dist/files.js",
      "default": "./dist/files.js"
    },
    "./usage": {
      "types": "./dist/usage.d.ts",
      "import": "./dist/usage.js",
      "default": "./dist/usage.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js",
      "default": "./dist/auth.js"
    },
    "./messages": {
      "types": "./dist/messages.d.ts",
      "import": "./dist/messages.js",
      "default": "./dist/messages.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "import": "./dist/state.js",
      "default": "./dist/state.js"
    },
    "./request": {
      "types": "./dist/request.d.ts",
      "import": "./dist/request.js",
      "default": "./dist/request.js"
    },
    "./stream": {
      "types": "./dist/stream.d.ts",
      "import": "./dist/stream.js",
      "default": "./dist/stream.js"
    },
    "./providers": {
      "types": "./dist/providers.d.ts",
      "import": "./dist/providers.js",
      "default": "./dist/providers.js"
    },
    "./providers/kit": {
      "types": "./dist/providers/kit.d.ts",
      "import": "./dist/providers/kit.js",
      "default": "./dist/providers/kit.js"
    },
    "./providers/kit/react": {
      "types": "./dist/providers/kit/react.d.ts",
      "import": "./dist/providers/kit/react.js",
      "default": "./dist/providers/kit/react.js"
    },
    "./providers/session-events": {
      "types": "./dist/providers/session-events.d.ts",
      "import": "./dist/providers/session-events.js",
      "default": "./dist/providers/session-events.js"
    },
    "./providers/bailian": {
      "types": "./dist/providers/bailian.d.ts",
      "import": "./dist/providers/bailian.js",
      "default": "./dist/providers/bailian.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "default": "./dist/protocol.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js",
      "default": "./dist/hooks.js"
    },
    "./chat/hooks": {
      "types": "./dist/chat/hooks.d.ts",
      "import": "./dist/chat/hooks.js",
      "default": "./dist/chat/hooks.js"
    },
    "./sessions/hooks": {
      "types": "./dist/sessions/hooks.d.ts",
      "import": "./dist/sessions/hooks.js",
      "default": "./dist/sessions/hooks.js"
    },
    "./files/hooks": {
      "types": "./dist/files/hooks.d.ts",
      "import": "./dist/files/hooks.js",
      "default": "./dist/files/hooks.js"
    },
    "./agents/hooks": {
      "types": "./dist/agents/hooks.d.ts",
      "import": "./dist/agents/hooks.js",
      "default": "./dist/agents/hooks.js"
    },
    "./usage/hooks": {
      "types": "./dist/usage/hooks.d.ts",
      "import": "./dist/usage/hooks.js",
      "default": "./dist/usage/hooks.js"
    },
    "./auth/hooks": {
      "types": "./dist/auth/hooks.d.ts",
      "import": "./dist/auth/hooks.js",
      "default": "./dist/auth/hooks.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "gen:api-types": "openapi-typescript ../../apps/server/openapi.json --output src/protocol/generated/openapi-types.ts"
  },
  "dependencies": {
    "@openagentpack/sdk": "0.10.0",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
