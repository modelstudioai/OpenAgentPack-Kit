{
  "$schema": "https://openagentpack.dev/schema/kit-chat-ui-registry.json",
  "name": "kit-chat-ui",
  "version": 1,
  "usage": "pnpm kit:add <component> 会把组件源码复制进你的项目（copy-in），可自由修改；升级时按 docs 的 diff 指引合并。",
  "components": {
    "layout": { "file": "src/components/layout/index.tsx", "deps": [], "npmDependencies": ["@radix-ui/react-dialog", "@openagentpack/kit-sdk"] },
    "chat": { "file": "src/components/chat/index.tsx", "deps": ["sender", "suggestion", "message", "process-step"] },
    "sender": { "file": "src/components/sender/index.tsx", "deps": [] },
    "attachments": { "file": "src/components/attachments/index.tsx", "deps": ["file-card"] },
    "suggestion": { "file": "src/components/suggestion/index.tsx", "deps": [] },
    "tooltip": { "file": "src/components/tooltip/index.tsx", "deps": [] },
    "menu": { "file": "src/components/menu/index.tsx", "deps": [], "npmDependencies": ["@radix-ui/react-dropdown-menu"] },
    "message": { "file": "src/components/message/index.tsx", "deps": ["markdown", "actions", "file-card", "execution-group", "reasoning-block", "tool-call-card", "sub-agent-card", "sender", "artifact-card", "message-list", "processing-indicator"] },
    "message-anchor-rail": { "file": "src/components/message-anchor-rail/index.tsx", "deps": ["tooltip"] },
    "message-skeleton": { "file": "src/components/message-skeleton/index.tsx", "deps": [] },
    "execution-group": { "file": "src/components/process/execution-group/index.tsx", "deps": ["reasoning-block", "tool-call-card"] },
    "sub-agent-card": { "file": "src/components/process/sub-agent-card/index.tsx", "deps": ["reasoning-block", "tool-call-card", "file-card"] },
    "sub-agent-panel": { "file": "src/components/process/sub-agent-panel/index.tsx", "deps": ["sub-agent-card"], "npmDependencies": ["@radix-ui/react-dialog"] },
    "process-step": { "file": "src/components/process/step/index.tsx", "deps": [] },
    "tool-call-card": { "file": "src/components/process/tool-call-card/index.tsx", "deps": ["process-step", "tool-summary", "markdown", "code-highlighter"] },
    "reasoning-block": { "file": "src/components/process/reasoning-block/index.tsx", "deps": ["process-step"] },
    "tool-summary": { "file": "src/components/process/tool-summary/index.ts", "deps": [] },
    "markdown": { "file": "src/components/markdown/index.tsx", "deps": ["code-highlighter", "mermaid"] },
    "actions": { "file": "src/components/actions/index.tsx", "deps": [] },
    "file-card": { "file": "src/components/file-card/index.tsx", "deps": [] },
    "code-highlighter": { "file": "src/components/code-highlighter/index.tsx", "deps": ["actions"] },
    "mermaid": { "file": "src/components/mermaid/index.tsx", "deps": ["actions", "code-highlighter"] },
    "agent-header": { "file": "src/components/agent-header/index.tsx", "deps": [] },
    "session-list": { "file": "src/components/session-list/index.tsx", "deps": ["tooltip", "process-step"] },
    "session-sidebar": { "file": "src/components/session-sidebar/index.tsx", "deps": ["session-list", "states"] },
    "states": { "file": "src/components/states/index.ts", "deps": ["empty-state", "error-state"] },
    "prompts": { "file": "src/components/prompts/index.tsx", "deps": [] },
    "plaza": { "file": "src/components/plaza/index.ts", "deps": ["activity-heatmap", "category-tabs", "meter-bar", "plaza-card"] },
    "tool-approval": { "file": "src/components/tool-approval/index.ts", "deps": ["tool-approval-card", "tool-approval-group"] },
    "chrome": { "file": "src/components/chrome/index.ts", "deps": ["agent-header", "confirm-dialog", "status-indicator", "thread-panel", "states"], "npmDependencies": ["@radix-ui/react-alert-dialog"] },
    "artifact-card": { "file": "src/components/artifact-card/index.tsx", "deps": ["file-card"] },
    "message-list": { "file": "src/components/message-list/index.tsx", "deps": ["message", "message-anchor-rail", "processing-indicator", "sub-agent-card"] },
    "processing-indicator": { "file": "src/components/processing-indicator/index.tsx", "deps": ["process-step"] },
    "status-indicator": { "file": "src/components/status-indicator/index.tsx", "deps": [] },
    "confirm-dialog": { "file": "src/components/confirm-dialog/index.tsx", "deps": [], "npmDependencies": ["@radix-ui/react-alert-dialog"] },
    "thread-panel": { "file": "src/components/thread-panel/index.tsx", "deps": ["message"] },
    "empty-state": { "file": "src/components/empty-state/index.tsx", "deps": [] },
    "error-state": { "file": "src/components/error-state/index.tsx", "deps": [] },
    "meter-bar": { "file": "src/components/meter-bar/index.tsx", "deps": [] },
    "activity-heatmap": { "file": "src/components/activity-heatmap/index.tsx", "deps": [] },
    "category-tabs": { "file": "src/components/category-tabs/index.tsx", "deps": [] },
    "plaza-card": { "file": "src/components/plaza-card/index.tsx", "deps": ["agent-header"] },
    "tool-approval-card": { "file": "src/components/tool-approval-card/index.tsx", "deps": [] },
    "tool-approval-group": { "file": "src/components/tool-approval-group/index.tsx", "deps": ["tool-approval-card"] }
  },
  "theme": "src/theme.css"
}
