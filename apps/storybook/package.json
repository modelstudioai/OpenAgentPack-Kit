{
  "name": "storybook",
  "version": "1.0.0",
  "private": true,
  "description": "OpenAgentPack Kit 文档站（Fumadocs + Next.js，对齐 ai-sdk.dev 的组织方式）",
  "license": "Apache-2.0",
  "scripts": {
    "predev": "node scripts/sync-openapi.mjs && node ../../scripts/skills/pack.mjs --docs",
    "dev": "next dev -p 3000",
    "prebuild": "node scripts/sync-openapi.mjs && node ../../scripts/skills/pack.mjs --docs && pnpm --filter @openagentpack/kit-chat-ui... build",
    "build": "next build && node scripts/copy-search-index.mjs",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "clean": "rm -rf .next"
  },
  "dependencies": {
    "@openagentpack/kit-chat-ui": "workspace:*",
    "@openagentpack/kit-sdk": "workspace:*",
    "fumadocs-core": "^16.17.1",
    "fumadocs-mdx": "^15.4.7",
    "fumadocs-openapi": "^12.4.2",
    "fumadocs-ui": "^16.17.1",
    "json-schema-typed": "^8.0.1",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
